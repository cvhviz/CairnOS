/* Notification body standing for several messages that arrived in one conversation while the app was away - %d is how many (2 or more) */
"notifications.catchUp.body" = "%d neue Nachrichten";

/* Notification title when the app has heard nothing from its radio for a while in the background (it may have been closed, or Bluetooth turned off) */
"notifications.notReceiving.title" = "Cairn empfängt möglicherweise nicht";

/* Notification body for that reminder - %@ is the radio's name */
"notifications.notReceiving.body" = "Von %@ ist seit einer Weile nichts eingegangen. Öffne Cairn, um Nachrichten abzuholen, die auf dem Funkgerät warten.";

/* Notification title when Bluetooth is turned off while the app wants its radio */
"notifications.bluetoothOff.title" = "Bluetooth ist aus";

/* Notification body when Bluetooth is turned off - %@ is the radio's name */
"notifications.bluetoothOff.body" = "Cairn kann keine Nachrichten von %@ empfangen, bis Bluetooth wieder eingeschaltet ist.";

/* Notification title when a Cairn radio's message queue lost messages while the app was away */
"notifications.radioQueueLoss.title" = "Nachrichten auf dem Funkgerät verloren";

/* Notification body for lost messages - %1$@ is the radio's name, %2$d how many messages were lost */
"notifications.radioQueueLoss.body" = "%1$@ hatte keinen Platz mehr für Nachrichten, während Cairn nicht verbunden war. Verlorene Nachrichten: %2$d.";


/* Home header card: how long ago the radio's readings were last read. %@ is an age such as 4m */
"home.header.updated" = "aktualisiert vor %@";
/* Location: AppCommands.swift - Menu of radio shortcuts (Connections, Device Info, Send Advert, Disconnect) */
"commands.radio" = "Funkgerät";

